# Copy to .env and adjust. Every variable is optional.

# Host port published by docker compose.
HOMEHQ_PORT=8787

# Initial admin account. If HOMEHQ_ADMIN_PASSWORD is empty a random password is generated on first start,
# printed once in the container log and written to data/secrets/initial-admin-password.txt.
# You will be asked to change it on first login.
HOMEHQ_ADMIN_USER=admin
HOMEHQ_ADMIN_PASSWORD=

# Master key used to encrypt stored secrets (Home Assistant token, calendar passwords).
# Leave empty to auto-generate data/secrets/master.key (chmod 600). Back it up together with the database.
HOMEHQ_SECRET_KEY=

# Cookie "Secure" flag for the admin session: auto (only when the request arrived over HTTPS), true, false.
# Use true as soon as the panel is served over HTTPS (reverse proxy); plain-HTTP LAN installs need auto/false.
HOMEHQ_COOKIE_SECURE=auto
# Set to true ONLY when running behind a reverse proxy that sets X-Forwarded-Proto / X-Forwarded-For.
HOMEHQ_TRUST_PROXY=false

# Extra browser origins allowed to call the API (comma separated). The Android kiosk origin is always allowed.
HOMEHQ_CORS_ORIGINS=

# Announce the backend on the LAN as _homehq._tcp (needs host networking, see docs/homehq-install.md).
HOMEHQ_MDNS_ENABLED=false
HOMEHQ_LOG_LEVEL=INFO
HOMEHQ_PHOTO_MAX_UPLOAD_MB=40
